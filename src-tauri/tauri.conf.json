{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Todo Widget",
  "version": "0.8.0",
  "identifier": "com.local.todowidget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Todo Widget",
        "width": 320,
        "height": 420,
        "minWidth": 280,
        "minHeight": 320,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": false,
        "visible": false,
        "resizable": true,
        "maximizable": false,
        "minimizable": true,
        "closable": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Windows 11 本地悬浮待办",
    "category": "Productivity",
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": { "displayLanguageSelector": false, "languages": ["SimpChinese"], "installMode": "currentUser" }
    }
  }
}
